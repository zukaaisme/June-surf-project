# Copy this file to .env.local for local testing.
# Vercel: add the same keys via Project → Settings → Environment Variables.
# Both are required for /api/apply to deliver submissions to Telegram.

# Bot token from @BotFather. Format: 123456789:ABC-DEF...xyz
TELEGRAM_BOT_TOKEN=

# Your numeric chat id (DM with the bot) or a group chat id (starts with -100...).
# Easiest way to find yours: open @userinfobot in Telegram, /start, copy the Id.
TELEGRAM_CHAT_ID=
